{
  "name": "api-modelo-base",
  "version": "0.1.0",
  "description": "API backend",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/shared/infra/https/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "activedirectory": "^0.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.0.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.45",
    "mongoose": "^8.24.1",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "opossum": "^9.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsyringe": "^4.8.0",
    "uuid": "^11.1.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-mongo-sanitize": "^2.1.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.14.5",
    "@types/node-cron": "^2.0.3",
    "@types/opossum": "^8.1.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9.8.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^15.6.0",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tscpaths": "^0.0.9",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8"
  },
  "resolutions": {
    "@types/express": "4.17.21",
    "_comment_seguranca": "Versoes forcadas para fechar alertas do Dependabot em dependencias transitivas. Reavaliar quando os pacotes pais subirem sozinhos.",
    "ws": "^8.21.0",
    "engine.io": "^6.6.7",
    "ip-address": "^10.1.1",
    "qs": "^6.15.2",
    "body-parser": "^1.20.6",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "js-yaml": "^4.3.0",
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.8"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "yarn clean && tsc && tscpaths -p tsconfig.json -s ./src -o ./dist",
    "dev": "ts-node-dev -r tsconfig-paths/register --inspect=0 --transpile-only --ignore-watch node_modules src/shared/infra/https/server.ts",
    "start": "node dist/shared/infra/https/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node -r tsconfig-paths/register src/configs/seeds/index.ts",
    "generate:module": "ts-node -r tsconfig-paths/register scripts/generate-module.ts",
    "generate:sub-module": "ts-node -r tsconfig-paths/register scripts/generate-sub-module.ts",
    "preset": "ts-node -r tsconfig-paths/register scripts/apply-template-preset.ts",
    "modules:list": "ts-node -r tsconfig-paths/register scripts/list-modules.ts",
    "check:imports": "ts-node -r tsconfig-paths/register scripts/check-imports.ts",
    "check:imports:fix": "ts-node -r tsconfig-paths/register scripts/check-imports.ts --fix",
    "check:boundaries": "ts-node -r tsconfig-paths/register scripts/check-boundaries.ts",
    "check:boundaries:report": "ts-node -r tsconfig-paths/register scripts/check-boundaries.ts --report",
    "dev:infra": "docker compose up -d mongo redis || echo \"\\n[dev:infra] Docker indisponivel. A API funciona sem ele: aponte MONGODB_URI_DEV no .env para um Mongo local. Sem Redis, /health responde 207 (degradado) e o cache fica desligado.\\n\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "load": "yarn && yarn build",
    "test": "npm run build && npx tsc -p scripts/tsconfig.json && node dist/scripts/scripts/run-tests.js",
    "test:watch": "npm run build && npx tsc -p scripts/tsconfig.json && node dist/scripts/scripts/run-tests.js --watch",
    "test:coverage": "npm run build && npx tsc -p scripts/tsconfig.json && node dist/scripts/scripts/run-tests.js --experimental-test-coverage"
  }
}

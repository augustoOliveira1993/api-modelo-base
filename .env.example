NODE_ENV=development
# Usado no nome dos arquivos de log e como nome do processo no PM2.
APP_NAME=backend-base-ts
PORT=4005
APP_WEB_URL=http://localhost
CORS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/backend_base
MONGODB_URI_DEV=mongodb://localhost:27017/backend_base_dev

SECRET=change-me-use-a-long-random-secret
REFRESH_SECRET=change-me-use-a-different-long-random-secret
# Senha aplicada quando um usuário é criado sem informar senha.
DEFAULT_USER_PASSWORD=change-me

# Credenciais do primeiro administrador, usadas por `yarn seed`.
# O signup da API sempre cria usuários com a role "Usuario"; este é o único
# caminho para ter um administrador num banco novo.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars

HTTPS_ENABLED=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
KEY_CERT=
KEY_KEY=
KEY_CA=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MONGO_PORT=27017
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

FEATURE_METRICS=false
FEATURE_HEALTH_CHECK=true
FEATURE_OPENAPI=true
FEATURE_RATE_LIMIT=true
FEATURE_HELMET=true
FEATURE_MONGO_SANITIZE=true
FEATURE_CIRCUIT_BREAKER=false
FEATURE_REDIS_CACHE=false
FEATURE_ROUTE_MONITORING=false
FEATURE_SOCKET_MANAGER=false
FEATURE_EMAIL_NOTIFICATIONS=false

# Active Directory (opcional). Se DOMAIN_CONTROLLER estiver definido, logins
# cujo e-mail termine nesse domínio são autenticados via LDAP; os demais, local.
AD_URL=ldap://seu-servidor-ad:389
DOMAIN_CONTROLLER=
# Contas do domínio acima que ainda assim autenticam localmente (ex.: contas de
# serviço/integração). Separadas por vírgula.
AD_LOCAL_FALLBACK_ACCOUNTS=

# Configuracoes opcionais de envio de e-mail via Microsoft Graph
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
MAIL_FROM_USER=
